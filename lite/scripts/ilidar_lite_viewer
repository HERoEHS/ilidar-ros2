#!/usr/bin/env python3

"""Discover optional LITE sensor names and supervise one RViz process."""

import copy
import os
import re
import shutil
import signal
import subprocess
import tempfile
import time

import rclpy
from rclpy.node import Node
import yaml


SENSOR_TOPIC_SUFFIXES = {
    "LITE Points": "points",
    "Depth Color Image": "depth/image_color",
    "Intensity Color Image": "intensity/image_color",
}
INFO_TOPIC_PATTERN = re.compile(r"^/ilidar_lite_(\w+)/info$")
DISCOVERY_SETTLE_SEC = 1.0
PROCESS_STOP_TIMEOUT_SEC = 5.0


def parse_sensor_names(text):
    """Parse a delimited sensor name list while preserving input order.

    Names are the identifier appended to /ilidar_lite_<name>. They may be
    numeric serial numbers (e.g. "99") or aliases (e.g. "left", "right").
    """
    tokens = [token for token in re.split(r"[\s,;]+", text.strip()) if token]
    if not tokens:
        raise ValueError("sensor_sns must contain at least one sensor name")

    sensor_names = []
    seen = set()
    for token in tokens:
        if not re.match(r"^\w+$", token):
            raise ValueError("invalid sensor name: {!r}".format(token))
        if token not in seen:
            seen.add(token)
            sensor_names.append(token)
    return sensor_names


def discover_sensor_names(node):
    """Collect every advertised sensor name, then return after the graph settles."""
    last_change_at = None
    discovered = set()
    node.get_logger().info("sensor_sns was omitted; discovering LITE sensors")

    while rclpy.ok():
        rclpy.spin_once(node, timeout_sec=0.1)
        current = set()
        for topic_name, _ in node.get_topic_names_and_types():
            match = INFO_TOPIC_PATTERN.match(topic_name)
            if match:
                current.add(match.group(1))

        if current != discovered:
            discovered = current
            last_change_at = time.monotonic()
            node.get_logger().info(
                "discovered sensor names: {}".format(
                    ", ".join(sorted(discovered))))

        now = time.monotonic()
        if discovered and now - last_change_at >= DISCOVERY_SETTLE_SEC:
            return sorted(discovered)
    raise RuntimeError("ROS shutdown while discovering LITE sensors")


def build_rviz_config(template_path, sensor_names, fixed_frame):
    """Clone the sensor display templates into one group per sensor name."""
    with open(template_path, "r", encoding="utf-8") as stream:
        config = yaml.safe_load(stream)

    manager = config["Visualization Manager"]
    source_displays = manager["Displays"]
    sensor_templates = {
        display.get("Name"): display
        for display in source_displays
        if display.get("Name") in SENSOR_TOPIC_SUFFIXES
    }
    missing = set(SENSOR_TOPIC_SUFFIXES) - set(sensor_templates)
    if missing:
        raise ValueError("RViz template is missing displays: {}".format(sorted(missing)))

    # Grid and TF remain global; sensor displays are cloned into one group per name.
    manager["Displays"] = [
        display
        for display in source_displays
        if display.get("Name") not in SENSOR_TOPIC_SUFFIXES
    ]
    manager["Global Options"]["Fixed Frame"] = fixed_frame
    manager["Views"]["Current"]["Target Frame"] = fixed_frame

    for sensor_name in sensor_names:
        topic_prefix = "/ilidar_lite_{}".format(sensor_name)
        displays = []
        for name, suffix in SENSOR_TOPIC_SUFFIXES.items():
            display = copy.deepcopy(sensor_templates[name])
            display["Name"] = name
            display["Topic"]["Value"] = "{}/{}".format(topic_prefix, suffix)
            displays.append(display)
        manager["Displays"].append(
            {
                "Class": "rviz_common/Group",
                "Displays": displays,
                "Enabled": True,
                "Name": "ilidar_lite_{}".format(sensor_name),
            }
        )
    return config


def stop_process(process):
    """Escalate RViz shutdown without allowing launch teardown to hang."""
    if process is None or process.poll() is not None:
        return
    process.send_signal(signal.SIGINT)
    try:
        process.wait(timeout=PROCESS_STOP_TIMEOUT_SEC)
        return
    except subprocess.TimeoutExpired:
        process.terminate()
    try:
        process.wait(timeout=PROCESS_STOP_TIMEOUT_SEC)
        return
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


def main():
    rclpy.init()
    node = Node("ilidar_lite_viewer")
    process = None
    temporary_path = None
    try:
        node.declare_parameter("sensor_sns", "")
        node.declare_parameter("fixed_frame", "base_link")
        node.declare_parameter("rviz_template", "")
        sensor_names_text = node.get_parameter("sensor_sns").value.strip()
        sensor_names = (
            parse_sensor_names(sensor_names_text)
            if sensor_names_text else discover_sensor_names(node)
        )
        fixed_frame = node.get_parameter("fixed_frame").value
        rviz_template = node.get_parameter("rviz_template").value
        config = build_rviz_config(rviz_template, sensor_names, fixed_frame)

        descriptor, temporary_path = tempfile.mkstemp(
            prefix="ilidar_lite_", suffix=".rviz"
        )
        os.close(descriptor)
        with open(temporary_path, "w", encoding="utf-8") as temporary:
            yaml.safe_dump(config, temporary, sort_keys=False)

        rviz_executable = shutil.which("rviz2")
        if rviz_executable is None:
            raise RuntimeError("rviz2 executable was not found")
        process = subprocess.Popen([rviz_executable, "-d", temporary_path])

        while rclpy.ok() and process.poll() is None:
            rclpy.spin_once(node, timeout_sec=0.1)
    finally:
        stop_process(process)
        if temporary_path is not None and os.path.exists(temporary_path):
            os.unlink(temporary_path)
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    try:
        main()
    except (KeyError, OSError, RuntimeError, ValueError, yaml.YAMLError) as error:
        print("Failed to start iLidar LITE RViz viewer: {}".format(error))
        raise SystemExit(1)
